# Copy to .env.local (ignored) and replace with origins you trust.
# The Python build/smoke helpers load .env.local; direct Gradle requires exported env.
# No shell expressions or interpolation; process environment wins over this file.
RPI_WEB_ANDROID_DEFAULT_ORIGIN=https://workspace.example
# Optional: leave blank to omit the development-site menu item.
RPI_WEB_ANDROID_DEVELOPMENT_ORIGIN=
